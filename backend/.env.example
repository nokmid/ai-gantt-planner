# Ключ OpenRouter — получить на https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Любая модель на OpenRouter с поддержкой tool calling:
# anthropic/claude-sonnet-4.6, openai/gpt-4.1, google/gemini-2.5-pro и т.д.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Домен фронтенда для CORS (после деплоя укажите реальный, например
# https://your-app.vercel.app). Локально можно оставить *
CORS_ORIGINS=*

# Опционально — просто попадает в заголовок X-Title запросов к OpenRouter
APP_URL=http://localhost:5173
